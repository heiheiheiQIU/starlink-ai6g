          "minimum": 0,
          "title": "Energy Lower Wh",
          "type": "number"
        },
        "energy_upper_Wh": {
          "minimum": 0,
          "title": "Energy Upper Wh",
          "type": "number"
        }
      },
      "required": [
        "time_s",
        "energy_lower_Wh",
        "energy_upper_Wh"
      ],
      "title": "EnergyBandPoint",
      "type": "object"
