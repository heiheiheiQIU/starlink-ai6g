    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_CONFIG",
            "RUN_NOT_FOUND",
            "RUN_NOT_COMPLETE",
            "CAPACITY_BUSY",
            "INTERNAL_RUN_ERROR"
          ],
