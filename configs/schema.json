{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "mode": {
          "enum": [
            "idle",
            "robust",
            "fast"
          ],
          "title": "Mode",
          "type": "string"
        },
        "scheduled_bytes": {
          "maximum": 1024,
          "minimum": 0,
          "title": "Scheduled Bytes",
          "type": "integer"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "fallback": {
          "title": "Fallback",
          "type": "boolean"
        }
      },
      "required": [
        "task_id",
        "mode",
        "scheduled_bytes",
        "reason_codes",
        "fallback"
      ],
      "title": "Action",
      "type": "object"
    },
    "CandidateScore": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "task_id": {
                "minLength": 1,
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "idle"
              }
            }
          },
          "then": {
            "properties": {
              "task_id": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "task_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "mode": {
          "enum": [
            "idle",
            "robust",
            "fast"
          ],
          "title": "Mode",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "task_id",
        "mode",
        "score"
      ],
      "title": "CandidateScore",
      "type": "object"
    },
    "ConstraintCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "passed",
        "details"
      ],
      "title": "ConstraintCheck",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "Python decoder return type; explicitly converted to wire event data.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "candidate_scores": {
          "items": {
            "$ref": "#/$defs/CandidateScore"
          },
          "title": "Candidate Scores",
          "type": "array"
        },
        "constraint_checks": {
          "items": {
            "$ref": "#/$defs/ConstraintCheck"
          },
          "title": "Constraint Checks",
          "type": "array"
        },
        "decision_latency_ms": {
          "minimum": 0,
          "title": "Decision Latency Ms",
          "type": "number"
        },
        "fallback": {
          "title": "Fallback",
          "type": "boolean"
        },
        "model_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        },
        "policy_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "action",
        "candidate_scores",
        "constraint_checks",
        "decision_latency_ms",
        "fallback",
        "model_version",
        "policy_version"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionData": {
      "additionalProperties": false,
      "description": "Wire payload, with the latency_ms field required by manual 09.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "candidate_scores": {
          "items": {
            "$ref": "#/$defs/CandidateScore"
          },
          "title": "Candidate Scores",
          "type": "array"
        },
        "constraint_checks": {
          "items": {
            "$ref": "#/$defs/ConstraintCheck"
          },
          "title": "Constraint Checks",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "fallback": {
          "title": "Fallback",
          "type": "boolean"
        },
        "model_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        },
        "policy_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "action",
        "candidate_scores",
        "constraint_checks",
        "latency_ms",
        "fallback",
        "model_version",
        "policy_version"
      ],
      "title": "DecisionData",
      "type": "object"
    },
    "EnergyBandPoint": {
      "additionalProperties": false,
