          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "EvaluationTruth": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "const": "posthoc_simulation",
          "title": "Label",
          "type": "string"
        },
        "soc_true": {
          "title": "Soc True",
          "type": "number"
        },
        "energy_true_Wh": {
          "title": "Energy True Wh",
          "type": "number"
        },
        "capacity_true_Wh": {
          "exclusiveMinimum": 0,
          "title": "Capacity True Wh",
          "type": "number"
        }
      },
      "required": [
        "label",
        "soc_true",
        "energy_true_Wh",
        "capacity_true_Wh"
      ],
      "title": "EvaluationTruth",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "exclusiveMinimum": 0,
          "title": "Event Id",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Run Id",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Policy Id",
          "type": "string"
        },
        "sim_time_s": {
          "minimum": 0,
          "title": "Sim Time S",
          "type": "number"
        },
        "event_type": {
          "enum": [
            "arrived",
            "sent",
            "received",
            "acked",
            "dropped",
            "fallback",
            "decision",
            "snapshot",
            "window_changed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "block_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Id"
        },
        "payload_bytes": {
          "minimum": 0,
          "title": "Payload Bytes",
          "type": "integer"
        },
        "overhead_bytes": {
          "minimum": 0,
          "title": "Overhead Bytes",
          "type": "integer"
        },
        "energy_Wh": {
          "minimum": 0,
          "title": "Energy Wh",
          "type": "number"
        },
        "reason_code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionData"
            },
            {
              "$ref": "#/$defs/SnapshotData"
            },
            {
              "$ref": "#/$defs/WindowChangedData"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data"
        }
      },
      "required": [
        "event_id",
        "run_id",
        "policy_id",
        "sim_time_s",
        "event_type",
        "task_id",
        "block_id",
        "payload_bytes",
        "overhead_bytes",
        "energy_Wh",
        "reason_code",
        "data"
      ],
      "title": "Event",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "decision"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/DecisionData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "snapshot"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/SnapshotData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "window_changed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/WindowChangedData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "enum": [
                  "arrived",
                  "sent",
                  "received",
                  "acked",
                  "dropped",
                  "fallback"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
